 "caps": [
  {
   "a": 0.86,
   "b": 2.6590000000000003,
   "html": "I'm a halal snack pack."
  },
  {
   "a": 2.659,
   "b": 4.585,
   "html": "A free trial ate my week."
  },
  {
   "a": 4.585,
   "b": 6.257,
   "html": "And something is <em>knocking</em>"
  },
  {
   "a": 6.257,
   "b": 8.003,
   "html": "from inside my fridge."
  },
  {
   "a": 8.503,
   "b": 10.186,
   "html": "The timer hit <em>zero</em>."
  },
  {
   "a": 10.186,
   "b": 12.114999999999998,
   "html": "The door opened by itself."
  },
  {
   "a": 12.115,
   "b": 13.399,
   "html": "And there they were."
  },
  {
   "a": 13.399000000000001,
   "b": 15.932,
   "html": "The sneakers. The headphones."
  },
  {
   "a": 15.932000000000002,
   "b": 18.34,
   "html": "Everything I wanted at <em>three in the morning</em>."
  },
  {
   "a": 18.940000000000005,
   "b": 20.748000000000005,
   "html": "Here's what nobody tells you."
  },
  {
   "a": 20.748000000000005,
   "b": 22.781000000000002,
   "html": "Every zombie started as a <em>want</em>."
  },
  {
   "a": 22.781000000000006,
   "b": 23.931000000000004,
   "html": "You want it."
  },
  {
   "a": 23.931000000000004,
   "b": 25.094000000000005,
   "html": "You buy it."
  },
  {
   "a": 25.094000000000005,
   "b": 26.330000000000005,
   "html": "You <em>forget</em> it."
  },
  {
   "a": 26.330000000000005,
   "b": 27.890000000000004,
   "html": "It never forgets <em>you</em>."
  },
  {
   "a": 28.840000000000007,
   "b": 30.601000000000006,
   "html": "Twenty-four hours were up."
  },
  {
   "a": 30.601000000000006,
   "b": 33.189,
   "html": "So I asked the only question that matters."
  },
  {
   "a": 33.18900000000001,
   "b": 34.572,
   "html": "Do I still <em>want</em> it?"
  },
  {
   "a": 34.57200000000001,
   "b": 36.739000000000004,
   "html": "The sneakers? <em>No.</em>"
  },
  {
   "a": 36.73900000000001,
   "b": 39.214000000000006,
   "html": "They screamed. Then they were <em>gone</em>."
  },
  {
   "a": 39.86400000000001,
   "b": 41.187000000000005,
   "html": "The headphones?"
  },
  {
   "a": 41.18700000000001,
   "b": 43.300000000000004,
   "html": "I actually still wanted those."
  },
  {
   "a": 43.30000000000001,
   "b": 45.62100000000001,
   "html": "They sat down. <em>Quietly.</em>"
  },
  {
   "a": 45.62100000000001,
   "b": 48.371,
   "html": "That's the difference between a want and a monster."
  },
  {
   "a": 48.37100000000001,
   "b": 49.40800000000001,
   "html": "<em>Time.</em>"
  },
  {
   "a": 50.108000000000004,
   "b": 51.801,
   "html": "Then the street went <em>quiet</em>."
  },
  {
   "a": 51.801,
   "b": 53.921,
   "html": "All of them. Stopped."
  },
  {
   "a": 53.921,
   "b": 55.873999999999995,
   "html": "Like they were waiting for <em>someone</em>."
  },
  {
   "a": 56.524,
   "b": 57.949999999999996,
   "html": "My phone lit up."
  },
  {
   "a": 57.95,
   "b": 60.164,
   "html": "<em>Your free trial has been upgraded.</em>"
  },
  {
   "a": 60.164,
   "b": 61.407,
   "html": "Annual plan."
  },
  {
   "a": 61.407000000000004,
   "b": 63.543,
   "html": "One hundred and eighty nine dollars."
  },
  {
   "a": 63.543000000000006,
   "b": 65.86,
   "html": "Billing starts in <em>twenty four hours</em>."
  },
  {
   "a": 66.55999999999999,
   "b": 68.77399999999999,
   "html": "The small ones were never the problem."
  },
  {
   "a": 68.77399999999999,
   "b": 70.46999999999998,
   "html": "They were the <em>welcome party</em>."
  },
  {
   "a": 70.46999999999998,
   "b": 72.58099999999999,
   "html": "Something much bigger was <em>waking up</em>."
  },
  {
   "a": 73.68099999999998,
   "b": 75.91699999999999,
   "html": "Part three. <em>Tomorrow.</em>"
  }
 ],
