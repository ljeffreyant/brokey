 "caps": [
  {
   "a": 1.3599999999999999,
   "b": 2.558,
   "html": "Day seven."
  },
  {
   "a": 2.558,
   "b": 4.849,
   "html": "One fry. One phone."
  },
  {
   "a": 4.849,
   "b": 7.325,
   "html": "And an annual plan <em>breaking through my wall</em>."
  },
  {
   "a": 7.875,
   "b": 9.42,
   "html": "I tried everything."
  },
  {
   "a": 9.420000000000002,
   "b": 12.816,
   "html": "Cancel buttons. Hiding. <em>Hoping.</em>"
  },
  {
   "a": 12.816000000000003,
   "b": 15.247000000000002,
   "html": "Nothing works on something that <em>renews</em>."
  },
  {
   "a": 15.897000000000004,
   "b": 17.567000000000004,
   "html": "Then I remembered an app."
  },
  {
   "a": 17.567000000000004,
   "b": 19.767000000000003,
   "html": "I had downloaded it at <em>three a.m.</em>"
  },
  {
   "a": 19.767000000000003,
   "b": 21.332,
   "html": "It was called <em>Brokey</em>."
  },
  {
   "a": 21.332000000000004,
   "b": 23.552000000000003,
   "html": "The mascot looked a lot like <em>me</em>."
  },
  {
   "a": 24.152000000000005,
   "b": 26.044000000000004,
   "html": "It does not cancel anything."
  },
  {
   "a": 26.044000000000004,
   "b": 27.728000000000005,
   "html": "It just tells you the <em>truth</em>."
  },
  {
   "a": 27.728000000000005,
   "b": 29.931000000000004,
   "html": "So I read the first line <em>out loud</em>."
  },
  {
   "a": 29.931000000000004,
   "b": 31.562000000000005,
   "html": "The gym zombie <em>flinched</em>."
  },
  {
   "a": 31.562000000000005,
   "b": 33.179,
   "html": "Then it started to <em>cry</em>."
  },
  {
   "a": 33.879000000000005,
   "b": 36.089,
   "html": "Gym. You went <em>twice</em>."
  },
  {
   "a": 36.089000000000006,
   "b": 38.747,
   "html": "Cloud. You have <em>never</em> opened it."
  },
  {
   "a": 38.74700000000001,
   "b": 42.165000000000006,
   "html": "Meal kit. You cooked <em>once</em>. Badly."
  },
  {
   "a": 42.165000000000006,
   "b": 45.703,
   "html": "Streaming. You watched <em>one show</em>. Twice."
  },
  {
   "a": 45.70300000000001,
   "b": 48.00900000000001,
   "html": "One by one, they <em>cancelled themselves</em>."
  },
  {
   "a": 48.659000000000006,
   "b": 50.464,
   "html": "The big one did not flinch."
  },
  {
   "a": 50.464000000000006,
   "b": 51.987,
   "html": "So I did the maths."
  },
  {
   "a": 51.98700000000001,
   "b": 53.86900000000001,
   "html": "One eighty nine, ninety nine."
  },
  {
   "a": 53.86900000000001,
   "b": 56.291000000000004,
   "html": "That's ten and a half halal snack packs."
  },
  {
   "a": 56.291000000000004,
   "b": 58.136,
   "html": "For a show you watched <em>twice</em>."
  },
  {
   "a": 58.136,
   "b": 59.35,
   "html": "And it <em>wept</em>."
  },
  {
   "a": 60.4,
   "b": 62.099,
   "html": "By morning, it was quiet."
  },
  {
   "a": 62.099,
   "b": 64.20599999999999,
   "html": "The fries came back on <em>Monday</em>."
  },
  {
   "a": 64.20599999999999,
   "b": 65.36999999999999,
   "html": "All nine."
  },
  {
   "a": 65.36999999999999,
   "b": 67.163,
   "html": "That's the thing about a <em>budget</em>."
  },
  {
   "a": 67.163,
   "b": 68.506,
   "html": "It <em>resets</em>."
  },
  {
   "a": 69.15599999999999,
   "b": 70.741,
   "html": "It's real, by the way."
  },
  {
   "a": 70.74099999999999,
   "b": 72.32099999999998,
   "html": "It is called <em>Brokey</em>."
  },
  {
   "a": 72.32099999999998,
   "b": 74.695,
   "html": "Your budget, in halal snack packs."
  },
  {
   "a": 74.69499999999998,
   "b": 76.87699999999998,
   "html": "It roasts you <em>before</em> the zombies do."
  },
  {
   "a": 77.52699999999997,
   "b": 78.91699999999997,
   "html": "I thought it was over."
  },
  {
   "a": 78.91699999999997,
   "b": 80.51899999999998,
   "html": "Then my phone <em>buzzed</em>."
  },
  {
   "a": 80.51899999999998,
   "b": 81.79999999999998,
   "html": "Pay in four."
  },
  {
   "a": 81.79999999999998,
   "b": 83.41499999999999,
   "html": "Four <em>easy</em> payments."
  },
  {
   "a": 83.41499999999998,
   "b": 85.15399999999998,
   "html": "Of nineteen ninety nine."
  },
  {
   "a": 85.15399999999998,
   "b": 87.08499999999998,
   "html": "And a hand came out of the <em>screen</em>."
  },
  {
   "a": 88.28499999999998,
   "b": 90.55599999999998,
   "html": "Season two. <em>Soon.</em>"
  }
 ],
