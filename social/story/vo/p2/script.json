[
 {
  "key": "b0c0",
  "text": "I'm a halal snack pack."
 },
 {
  "key": "b0c1",
  "text": "A free trial ate my week."
 },
 {
  "key": "b0c2",
  "text": "And something is knocking"
 },
 {
  "key": "b0c3",
  "text": "from inside my fridge."
 },
 {
  "key": "b1c0",
  "text": "The timer hit zero."
 },
 {
  "key": "b1c1",
  "text": "The door opened by itself."
 },
 {
  "key": "b1c2",
  "text": "And there they were."
 },
 {
  "key": "b1c3",
  "text": "The sneakers. The headphones."
 },
 {
  "key": "b1c4",
  "text": "Everything I wanted at three in the morning."
 },
 {
  "key": "b2c0",
  "text": "Here's what nobody tells you."
 },
 {
  "key": "b2c1",
  "text": "Every zombie started as a want."
 },
 {
  "key": "b2c2",
  "text": "You want it."
 },
 {
  "key": "b2c3",
  "text": "You buy it."
 },
 {
  "key": "b2c4",
  "text": "You forget it."
 },
 {
  "key": "b2c5",
  "text": "It never forgets you."
 },
 {
  "key": "b3c0",
  "text": "Twenty-four hours were up."
 },
 {
  "key": "b3c1",
  "text": "So I asked the only question that matters."
 },
 {
  "key": "b3c2",
  "text": "Do I still want it?"
 },
 {
  "key": "b3c3",
  "text": "The sneakers? No."
 },
 {
  "key": "b3c4",
  "text": "They screamed. Then they were gone."
 },
 {
  "key": "b4c0",
  "text": "The headphones?"
 },
 {
  "key": "b4c1",
  "text": "I actually still wanted those."
 },
 {
  "key": "b4c2",
  "text": "They sat down. Quietly."
 },
 {
  "key": "b4c3",
  "text": "That's the difference between a want and a monster."
 },
 {
  "key": "b4c4",
  "text": "Time."
 },
 {
  "key": "b5c0",
  "text": "Then the street went quiet."
 },
 {
  "key": "b5c1",
  "text": "All of them. Stopped."
 },
 {
  "key": "b5c2",
  "text": "Like they were waiting for someone."
 },
 {
  "key": "b6c0",
  "text": "My phone lit up."
 },
 {
  "key": "b6c1",
  "text": "Your free trial has been upgraded."
 },
 {
  "key": "b6c2",
  "text": "Annual plan."
 },
 {
  "key": "b6c3",
  "text": "One hundred and eighty nine dollars."
 },
 {
  "key": "b6c4",
  "text": "Billing starts in twenty four hours."
 },
 {
  "key": "b7c0",
  "text": "The small ones were never the problem."
 },
 {
  "key": "b7c1",
  "text": "They were the welcome party."
 },
 {
  "key": "b7c2",
  "text": "Something much bigger was waking up."
 },
 {
  "key": "b8c0",
  "text": "Part three. Tomorrow."
 }
]