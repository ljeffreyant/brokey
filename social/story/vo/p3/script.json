[
 {
  "key": "b0c0",
  "text": "Day seven."
 },
 {
  "key": "b0c1",
  "text": "One fry. One phone."
 },
 {
  "key": "b0c2",
  "text": "And an annual plan breaking through my wall."
 },
 {
  "key": "b1c0",
  "text": "I tried everything."
 },
 {
  "key": "b1c1",
  "text": "Cancel buttons. Hiding. Hoping."
 },
 {
  "key": "b1c2",
  "text": "Nothing works on something that renews."
 },
 {
  "key": "b2c0",
  "text": "Then I remembered an app."
 },
 {
  "key": "b2c1",
  "text": "I had downloaded it at three a.m."
 },
 {
  "key": "b2c2",
  "text": "It was called Brokey."
 },
 {
  "key": "b2c3",
  "text": "The mascot looked a lot like me."
 },
 {
  "key": "b3c0",
  "text": "It does not cancel anything."
 },
 {
  "key": "b3c1",
  "text": "It just tells you the truth."
 },
 {
  "key": "b3c2",
  "text": "So I read the first line out loud."
 },
 {
  "key": "b3c3",
  "text": "The gym zombie flinched."
 },
 {
  "key": "b3c4",
  "text": "Then it started to cry."
 },
 {
  "key": "b4c0",
  "text": "Gym. You went twice."
 },
 {
  "key": "b4c1",
  "text": "Cloud. You have never opened it."
 },
 {
  "key": "b4c2",
  "text": "Meal kit. You cooked once. Badly."
 },
 {
  "key": "b4c3",
  "text": "Streaming. You watched one show. Twice."
 },
 {
  "key": "b4c4",
  "text": "One by one, they cancelled themselves."
 },
 {
  "key": "b5c0",
  "text": "The big one did not flinch."
 },
 {
  "key": "b5c1",
  "text": "So I did the maths."
 },
 {
  "key": "b5c2",
  "text": "One eighty nine, ninety nine."
 },
 {
  "key": "b5c3",
  "text": "That's ten and a half halal snack packs."
 },
 {
  "key": "b5c4",
  "text": "For a show you watched twice."
 },
 {
  "key": "b5c5",
  "text": "And it wept."
 },
 {
  "key": "b6c0",
  "text": "By morning, it was quiet."
 },
 {
  "key": "b6c1",
  "text": "The fries came back on Monday."
 },
 {
  "key": "b6c2",
  "text": "All nine."
 },
 {
  "key": "b6c3",
  "text": "That's the thing about a budget."
 },
 {
  "key": "b6c4",
  "text": "It resets."
 },
 {
  "key": "b7c0",
  "text": "It's real, by the way."
 },
 {
  "key": "b7c1",
  "text": "It is called Brokey."
 },
 {
  "key": "b7c2",
  "text": "Your budget, in halal snack packs."
 },
 {
  "key": "b7c3",
  "text": "It roasts you before the zombies do."
 },
 {
  "key": "b8c0",
  "text": "I thought it was over."
 },
 {
  "key": "b8c1",
  "text": "Then my phone buzzed."
 },
 {
  "key": "b8c2",
  "text": "Pay in four."
 },
 {
  "key": "b8c3",
  "text": "Four easy payments."
 },
 {
  "key": "b8c4",
  "text": "Of nineteen ninety nine."
 },
 {
  "key": "b8c5",
  "text": "And a hand came out of the screen."
 },
 {
  "key": "b9c0",
  "text": "Season two. Soon."
 }
]