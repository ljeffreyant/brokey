[
 {
  "key": "b0c0",
  "text": "Day six."
 },
 {
  "key": "b0c1",
  "text": "Three twelve a.m."
 },
 {
  "key": "b0c2",
  "text": "Something is knocking at my door."
 },
 {
  "key": "b1c0",
  "text": "It knows my name."
 },
 {
  "key": "b1c1",
  "text": "It knows my card number."
 },
 {
  "key": "b1c2",
  "text": "And it charges me to stand there."
 },
 {
  "key": "b3c0",
  "text": "Day one."
 },
 {
  "key": "b3c1",
  "text": "I'm a halal snack pack."
 },
 {
  "key": "b3c2",
  "text": "Nine fries."
 },
 {
  "key": "b3c3",
  "text": "That's my whole budget for the week."
 },
 {
  "key": "b4c0",
  "text": "Then a banner popped up."
 },
 {
  "key": "b4c1",
  "text": "Seven days free."
 },
 {
  "key": "b4c2",
  "text": "I tapped it."
 },
 {
  "key": "b4c3",
  "text": "Zero dollars."
 },
 {
  "key": "b4c4",
  "text": "That should have been the first warning."
 },
 {
  "key": "b5c0",
  "text": "Day two."
 },
 {
  "key": "b5c1",
  "text": "One bubble tea."
 },
 {
  "key": "b5c2",
  "text": "Doesn't count."
 },
 {
  "key": "b5c3",
  "text": "Then it was lunch."
 },
 {
  "key": "b5c4",
  "text": "Then there were five."
 },
 {
  "key": "b6c0",
  "text": "Day three."
 },
 {
  "key": "b6c1",
  "text": "I opened my bank app, and saw them."
 },
 {
  "key": "b6c2",
  "text": "A gym I haven't entered since March."
 },
 {
  "key": "b6c3",
  "text": "A cloud I never use."
 },
 {
  "key": "b6c4",
  "text": "An app I can't even name."
 },
 {
  "key": "b6c5",
  "text": "Still charging."
 },
 {
  "key": "b7c0",
  "text": "Day four."
 },
 {
  "key": "b7c1",
  "text": "They started walking."
 },
 {
  "key": "b7c2",
  "text": "Slowly."
 },
 {
  "key": "b7c3",
  "text": "Politely."
 },
 {
  "key": "b7c4",
  "text": "Because every month,"
 },
 {
  "key": "b7c5",
  "text": "they have all the time."
 },
 {
  "key": "b8c0",
  "text": "Day five."
 },
 {
  "key": "b8c1",
  "text": "One rule worked."
 },
 {
  "key": "b8c2",
  "text": "Don't buy it."
 },
 {
  "key": "b8c3",
  "text": "Put it in the fridge."
 },
 {
  "key": "b8c4",
  "text": "Twenty-four hours."
 },
 {
  "key": "b8c5",
  "text": "If you still want it tomorrow, it's yours."
 },
 {
  "key": "b9c0",
  "text": "Day six."
 },
 {
  "key": "b9c1",
  "text": "The fridge held."
 },
 {
  "key": "b9c2",
  "text": "My wallet didn't."
 },
 {
  "key": "b9c3",
  "text": "One fry left."
 },
 {
  "key": "b10c0",
  "text": "Three nineteen a.m."
 },
 {
  "key": "b10c1",
  "text": "The knocking stopped."
 },
 {
  "key": "b10c2",
  "text": "I thought they had given up."
 },
 {
  "key": "b11c0",
  "text": "Then I heard it again."
 },
 {
  "key": "b11c1",
  "text": "Not at the door."
 },
 {
  "key": "b11c2",
  "text": "Inside my fridge."
 },
 {
  "key": "b12c0",
  "text": "Part two. Tomorrow."
 }
]