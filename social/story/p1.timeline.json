 "caps": [
  {
   "a": 1.46,
   "b": 2.677,
   "html": "Day six."
  },
  {
   "a": 2.6769999999999996,
   "b": 4.241,
   "html": "Three twelve <em>a.m.</em>"
  },
  {
   "a": 4.241,
   "b": 6.272,
   "html": "Something is <em>knocking</em> at my door."
  },
  {
   "a": 6.621999999999999,
   "b": 8.056999999999999,
   "html": "It knows my <em>name</em>."
  },
  {
   "a": 8.057,
   "b": 9.774,
   "html": "It knows my <em>card number</em>."
  },
  {
   "a": 9.774000000000001,
   "b": 11.815,
   "html": "And it charges me to <em>stand there</em>."
  },
  {
   "a": 15.365000000000002,
   "b": 16.450000000000003,
   "html": "Day one."
  },
  {
   "a": 16.450000000000003,
   "b": 18.249000000000002,
   "html": "I'm a halal snack pack."
  },
  {
   "a": 18.249000000000002,
   "b": 19.596,
   "html": "Nine fries."
  },
  {
   "a": 19.596000000000004,
   "b": 21.601000000000003,
   "html": "That's my whole <em>budget</em> for the week."
  },
  {
   "a": 22.151000000000003,
   "b": 23.819000000000003,
   "html": "Then a banner popped up."
  },
  {
   "a": 23.819000000000003,
   "b": 25.323,
   "html": "<em>Seven days free.</em>"
  },
  {
   "a": 25.323000000000004,
   "b": 26.560000000000002,
   "html": "I tapped it."
  },
  {
   "a": 26.560000000000002,
   "b": 27.885,
   "html": "<em>Zero</em> dollars."
  },
  {
   "a": 27.885,
   "b": 29.895,
   "html": "That should have been the <em>first warning</em>."
  },
  {
   "a": 30.495000000000005,
   "b": 31.629000000000005,
   "html": "Day two."
  },
  {
   "a": 31.629000000000005,
   "b": 32.973,
   "html": "One bubble tea."
  },
  {
   "a": 32.973000000000006,
   "b": 34.164,
   "html": "Doesn't <em>count</em>."
  },
  {
   "a": 34.16400000000001,
   "b": 35.426,
   "html": "Then it was lunch."
  },
  {
   "a": 35.42600000000001,
   "b": 36.827000000000005,
   "html": "Then there were <em>five</em>."
  },
  {
   "a": 37.37700000000001,
   "b": 38.523,
   "html": "Day three."
  },
  {
   "a": 38.52300000000001,
   "b": 40.656000000000006,
   "html": "I opened my bank app, and saw them."
  },
  {
   "a": 40.65600000000001,
   "b": 42.86200000000001,
   "html": "A gym I haven't entered since <em>March</em>."
  },
  {
   "a": 42.862000000000016,
   "b": 44.69600000000001,
   "html": "A cloud I never use."
  },
  {
   "a": 44.69600000000002,
   "b": 46.46200000000002,
   "html": "An app I can't even <em>name</em>."
  },
  {
   "a": 46.46200000000002,
   "b": 47.78700000000001,
   "html": "Still <em>charging</em>."
  },
  {
   "a": 48.48700000000002,
   "b": 49.66200000000002,
   "html": "Day four."
  },
  {
   "a": 49.66200000000002,
   "b": 51.070000000000014,
   "html": "They started <em>walking</em>."
  },
  {
   "a": 51.07000000000002,
   "b": 52.14800000000002,
   "html": "Slowly."
  },
  {
   "a": 52.148000000000025,
   "b": 53.27300000000002,
   "html": "Politely."
  },
  {
   "a": 53.273000000000025,
   "b": 54.749000000000024,
   "html": "Because every month,"
  },
  {
   "a": 54.749000000000024,
   "b": 56.24800000000002,
   "html": "they have <em>all the time</em>."
  },
  {
   "a": 56.898000000000025,
   "b": 58.07100000000002,
   "html": "Day five."
  },
  {
   "a": 58.071000000000026,
   "b": 59.42600000000002,
   "html": "One rule <em>worked</em>."
  },
  {
   "a": 59.42600000000002,
   "b": 60.61400000000002,
   "html": "Don't buy it."
  },
  {
   "a": 60.614000000000026,
   "b": 61.999000000000024,
   "html": "Put it in the <em>fridge</em>."
  },
  {
   "a": 61.999000000000024,
   "b": 63.53500000000002,
   "html": "Twenty-four hours."
  },
  {
   "a": 63.535000000000025,
   "b": 65.90400000000002,
   "html": "If you still want it tomorrow, it's <em>yours</em>."
  },
  {
   "a": 66.55400000000002,
   "b": 67.78100000000002,
   "html": "Day six."
  },
  {
   "a": 67.78100000000002,
   "b": 69.13200000000002,
   "html": "The fridge <em>held</em>."
  },
  {
   "a": 69.13200000000002,
   "b": 70.55800000000002,
   "html": "My wallet <em>didn't</em>."
  },
  {
   "a": 70.55800000000002,
   "b": 71.99400000000003,
   "html": "One fry left."
  },
  {
   "a": 72.84400000000001,
   "b": 74.46700000000001,
   "html": "Three nineteen <em>a.m.</em>"
  },
  {
   "a": 74.46700000000001,
   "b": 76.02600000000001,
   "html": "The knocking <em>stopped</em>."
  },
  {
   "a": 76.02600000000001,
   "b": 77.66700000000002,
   "html": "I thought they had given up."
  },
  {
   "a": 78.367,
   "b": 79.811,
   "html": "Then I heard it again."
  },
  {
   "a": 79.811,
   "b": 81.034,
   "html": "Not at the door."
  },
  {
   "a": 81.034,
   "b": 82.682,
   "html": "Inside my <em>fridge</em>."
  },
  {
   "a": 83.882,
   "b": 86.117,
   "html": "Part two. <em>Tomorrow.</em>"
  }
 ],
